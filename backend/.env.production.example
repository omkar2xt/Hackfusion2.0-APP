# ==============================================================================
# YODHRA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (Render & Supabase)
# ==============================================================================
# IMPORTANT: Copy these settings into your Render Dashboard -> Environment section.
# Do NOT commit your real production secrets to git.

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
HOST=0.0.0.0
# PORT is assigned dynamically by Render at runtime (e.g. 10000). Do not hardcode.

# 2. SUPABASE POSTGRESQL SESSION POOLER CONNECTION URI (Required)
# Format: postgresql+psycopg://[USERNAME]:[ENCODED_PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Verified Supabase Pooler Host: aws-1-eu-west-3.pooler.supabase.com
# Verified Supabase Username: postgres.wevmeqdidigchvkxmgkf
# Note: If your password contains special characters like '@', ':', '#', or '%',
# the YODHRA backend will automatically percent-encode them safely.
DATABASE_URL=postgresql+psycopg://postgres.wevmeqdidigchvkxmgkf:YOUR_SUPABASE_DB_PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# (Alternative) If you pasted a psql command into DATABASE_URL, you can supply PGPASSWORD separately:
# PGPASSWORD=YOUR_SUPABASE_DB_PASSWORD

# 3. CORS ALLOWED ORIGINS (Comma-separated)
# Add your production frontend URLs (e.g., Vercel, Netlify, custom domain)
ALLOWED_ORIGINS=https://yodhra.vercel.app,https://yodhra-preview.vercel.app

# 4. OPTIONAL SUPABASE INTEGRATION (Service-side only)
SUPABASE_URL=https://wevmeqdidigchvkxmgkf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# 5. OPTIONAL THREAT INTELLIGENCE APIS (VirusTotal / Google Safe Browsing)
THREAT_INTELLIGENCE_API_KEY=
